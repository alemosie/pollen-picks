# Register an app at https://publish.buffer.com/settings/api
# Redirect URI must match exactly (add the production one later too)
BUFFER_CLIENT_ID=
# Only for confidential (server-side) clients. Leave empty for a public client using PKCE only.
BUFFER_CLIENT_SECRET=
BUFFER_REDIRECT_URI=https://localhost:3003/api/auth/buffer/callback
# 32+ random characters: openssl rand -base64 32
SESSION_SECRET=
# Optional: comma-separated public image URLs for the spike draft
SPIKE_IMAGE_URLS=

# Supabase project "Pollen Picks". Server only: never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=https://hmzprlzhvhdwpjgrymrk.supabase.co
# Secret key (sb_secret_...) from Project Settings -> API Keys. It bypasses RLS, so it stays in server env vars (Netlify too).
SUPABASE_SECRET_KEY=

# Local testing only: BUFFER_FAKE=1 skips Buffer and returns realistic results, so Send now can be built and tried without
# publishing anything. Ignored in production builds. Optional comma-separated networks to simulate problems:
#   BUFFER_FAKE_CHANNELS=60            add this many fake channels (up to 200) to your real ones
#   BUFFER_FAKE_FAIL=instagram         Buffer rejects the post
#   BUFFER_FAKE_UNKNOWN=linkedin       request dies mid-way (outcome unknown)
#   BUFFER_FAKE_PUBLISH_FAIL=linkedin  Buffer accepts the post but can't publish it
BUFFER_FAKE=
BUFFER_FAKE_CHANNELS=
BUFFER_FAKE_FAIL=
BUFFER_FAKE_UNKNOWN=
BUFFER_FAKE_PUBLISH_FAIL=

# Buffer fetches the slide images itself, so it needs a public address for this app. Not needed on the deployed site or in
# fake mode. For a real send from your own machine, run a tunnel and put its address here, then restart `yarn dev`:
#   cloudflared tunnel --url https://localhost:3003 --no-tls-verify
PUBLIC_BASE_URL=
